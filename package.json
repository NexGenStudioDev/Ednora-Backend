{
  "name": "eduvanta-backend",
  "description": "Eduvanta API Engine — Where Knowledge Finds Its Future.",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node src/index.mjs",
    "build": "echo 'Build complete'",
    "start": "node src/index.mjs",
    "start:dev": "nodemon  src/index.mjs",
    "lint": "eslint .",
    "tailwind:build": "npx @tailwindcss/cli -i src/api/v1/Email/css/input.css -o src/api/v1/Email/css/output.css --watch",
    "@eslint/config-inspector": "npx @eslint/config-inspector@latest",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "genKey": "node src/script/genKey.mjs",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js",
    "test:watch": "node --experimental-vm-modules node_modules/jest/bin/jest.js --watch"
  },
  "dependencies": {
    "@google/genai": "^1.52.0",
    "@tailwindcss/cli": "4.1.1",
    "amqplib": "^2.2.0",
    "bcryptjs": "2.4.3",
    "body-parser": "1.20.3",
    "cashfree-pg": "^5.1.3",
    "cloudinary": "2.5.1",
    "cookie": "^1.1.1",
    "cookie-parser": "1.4.7",
    "cors": "2.8.5",
    "debug": "2.6.9",
    "dotenv": "16.4.5",
    "express": "4.21.2",
    "express-rate-limit": "7.4.1",
    "express-session": "1.18.1",
    "google-auth-library": "9.14.2",
    "googleapis": "144.0.0",
    "helmet": "^8.3.0",
    "http-errors": "1.6.3",
    "joi": "17.13.3",
    "jsonwebtoken": "9.0.2",
    "lolcatjs": "2.4.3",
    "mongoose": "^8.24.6",
    "multer": "1.4.5-lts.2",
    "node-cron": "3.0.3",
    "nodemailer": "^6.10.1",
    "otp-generation": "1.0.5",
    "pino": "9.4.0",
    "pino-http": "10.3.0",
    "pino-pretty": "11.2.2",
    "razorpay": "2.9.5",
    "socket.io": "^4.8.4",
    "tailwindcss": "^4.3.3",
    "uuid": "^11.1.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@babel/preset-env": "^7.29.7",
    "@eslint/js": "9.12.0",
    "@jest/globals": "^29.7.0",
    "babel-jest": "^29.7.0",
    "eslint": "9.12.0",
    "eslint-config-prettier": "9.1.0",
    "eslint-plugin-prettier": "5.2.1",
    "globals": "15.11.0",
    "jest": "^29.7.0",
    "nodemon": "^3.1.14",
    "prettier": "3.3.3",
    "swagger-autogen": "2.23.7"
  },
  "jest": {
    "testEnvironment": "node",
    "moduleFileExtensions": [
      "js",
      "mjs"
    ],
    "testMatch": [
      "**/__tests__/**/*.test.mjs"
    ],
    "moduleNameMapper": {
      "^(\\.{1,2}/.*)\\.mjs$": "$1"
    }
  }
}
